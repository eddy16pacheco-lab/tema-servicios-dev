<section class="block" id="experiencia">
  <div class="wrap narrow-lg">
    <h2>{{ section.settings.heading }}</h2>
    {% for block in section.blocks %}
      <article class="card job" {{ block.shopify_attributes }}>
        <h3>{{ block.settings.role }}</h3>
        <p class="muted">{{ block.settings.company }} · {{ block.settings.period }}</p>
        <ul>{% assign lines = block.settings.bullets | newline_to_br | split: '<br />' %}{% for l in lines %}{% assign t = l | strip %}{% if t != blank %}<li>{{ t }}</li>{% endif %}{% endfor %}</ul>
      </article>
    {% endfor %}
  </div>
</section>
{% schema %}
{ "name": "Experiencia",
  "settings": [ { "type": "text", "id": "heading", "label": "Título", "default": "Experiencia laboral" } ],
  "blocks": [ { "type": "job", "name": "Cargo", "settings": [
    { "type": "text", "id": "role", "label": "Cargo" }, { "type": "text", "id": "company", "label": "Organización" },
    { "type": "text", "id": "period", "label": "Duración" },
    { "type": "textarea", "id": "bullets", "label": "Logros (uno por línea)" } ] } ],
  "presets": [ { "name": "Experiencia" } ] }
{% endschema %}
