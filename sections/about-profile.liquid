<section class="block" id="sobre-mi">
  <div class="wrap about">
    <div>
      <h2>{{ section.settings.heading }}</h2>
      <div class="rte">{{ section.settings.text }}</div>
    </div>
    <aside class="card">
      <h3>Formación</h3>
      <ul class="plain">
        {% for block in section.blocks %}
          <li {{ block.shopify_attributes }}><strong>{{ block.settings.title }}</strong><span class="muted">{{ block.settings.detail }}</span></li>
        {% endfor %}
      </ul>
      <h3>Idiomas</h3>
      <p class="muted">{{ section.settings.languages }}</p>
      <h3>Ubicación</h3>
      <p class="muted">{{ section.settings.location }}</p>
    </aside>
  </div>
</section>
{% schema %}
{ "name": "Sobre mí",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Sobre mí" },
    { "type": "richtext", "id": "text", "label": "Perfil profesional" },
    { "type": "text", "id": "languages", "label": "Idiomas", "default": "Español (nativo) · Inglés (intermedio)" },
    { "type": "text", "id": "location", "label": "Ubicación", "default": "Acevedo, Miranda, Venezuela" }
  ],
  "blocks": [ { "type": "education", "name": "Formación", "settings": [
    { "type": "text", "id": "title", "label": "Título" }, { "type": "text", "id": "detail", "label": "Institución" } ] } ],
  "presets": [ { "name": "Sobre mí" } ] }
{% endschema %}
