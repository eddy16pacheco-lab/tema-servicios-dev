{%- comment -%} Uso: {% render 'service-card', product: product %} {%- endcomment -%}
<article class="card service-card">
  {% if product.featured_image %}
    <a href="{{ product.url }}">{{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: product.title }}</a>
  {% endif %}
  <h3><a href="{{ product.url }}">{{ product.title }}</a></h3>
  <p class="muted">{{ product.description | strip_html | truncate: 120 }}</p>
  <p class="price">
    {%- if product.tags contains 'cotizacion' -%}Precio bajo cotización
    {%- else -%}Desde {{ product.price_min | money }}{%- endif -%}
  </p>
  {% if product.tags contains 'cotizacion' %}
    {% render 'button', url: '/pages/contact', label: 'Solicitar presupuesto', style: 'ghost' %}
  {% else %}
    {% render 'button', url: product.url, label: 'Ver y contratar', style: 'primary' %}
  {% endif %}
</article>
