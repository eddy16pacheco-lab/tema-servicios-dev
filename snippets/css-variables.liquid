<style>
  :root {
    --bg: {{ settings.color_bg }};
    --surface: {{ settings.color_surface }};
    --text: {{ settings.color_text }};
    --muted: {{ settings.color_muted }};
    --accent: {{ settings.color_accent }};
    --accent2: {{ settings.color_accent2 }};
    --accent3: {{ settings.color_accent3 }};
    --accent-ink: {{ settings.color_accent_ink }};
    --border: color-mix(in srgb, var(--text) 10%, transparent);
    --grad: linear-gradient(90deg, var(--accent), var(--accent2) 55%, var(--accent3));
    --font-head: {{ settings.font_heading }}, system-ui, sans-serif;
    --font-body: {{ settings.font_body }}, system-ui, sans-serif;
    --font-mono: {{ settings.font_mono }}, ui-monospace, monospace;
  }
  body.theme-light { --bg:#f3f6fb; --surface:#fff; --text:#0b1220; --muted:#475569; }
</style>
